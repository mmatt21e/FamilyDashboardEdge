rules_version = '2';

// Firestore security rules for the family dashboard.
//
// Paste these into Firebase console → Firestore Database → Rules → Publish.
//
// The model is deliberately simple because this is ONE family's private app,
// not a multi-tenant product: if you have a document in /members, you are in
// the family and you can read and write the family's data. There is no
// per-record ownership beyond "you can only delete your own posts".
//
// BOOTSTRAPPING: the first member has to be added by hand, otherwise nobody
// could ever get in - the rules require a member document to create a member
// document. In the Firebase console, create:
//
//     /members/<your-firebase-auth-uid>   { email: "you@example.com" }
//
// After that, everyone else is added automatically when they first sign in.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The allowlist. Membership is the only permission this app has.
    function isFamily() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    // An invitation that is real, still live, and meant for whoever is holding
    // it. This is the ONLY route into the family that does not already require
    // being in it, so every condition here is load-bearing:
    //
    //   revoked / usedBy   - cancelled and spent invitations are dead
    //   expiresAt          - epoch millis, so it can be compared to request.time
    //   email              - required; only that Google account may use it, so
    //                        a forwarded link is worthless to anybody else
    function validInvite(code) {
      return signedIn()
        && code is string
        && exists(/databases/$(database)/documents/invitations/$(code))
        && inviteData(code).revoked != true
        && inviteData(code).usedBy == null
        && inviteData(code).expiresAt is number
        && request.time.toMillis() < inviteData(code).expiresAt
        && inviteData(code).email is string
        && inviteData(code).email == request.auth.token.email;
    }

    function inviteData(code) {
      return get(/databases/$(database)/documents/invitations/$(code)).data;
    }

    // Invitations are created by family members, but their security properties
    // are still enforced here so a modified browser cannot create an open-ended
    // or link-only invitation.
    function safeNewInvite(code) {
      return request.resource.data.keys().hasAll([
          'code', 'name', 'email', 'invitedBy', 'invitedByName', 'createdAt',
          'expiresAt', 'usedBy', 'usedAt', 'revoked'
        ])
        && request.resource.data.keys().hasOnly([
          'code', 'name', 'email', 'invitedBy', 'invitedByName', 'createdAt',
          'expiresAt', 'usedBy', 'usedAt', 'revoked'
        ])
        && request.resource.data.code == code
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 1209600000
        && request.resource.data.usedBy == null
        && request.resource.data.usedAt == null
        && request.resource.data.revoked == false;
    }

    function safeFamilyInviteUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['revoked', 'sentAt', 'sentBy'])
        && (!changed.hasAny(['revoked']) || request.resource.data.revoked == true)
        && (!changed.hasAny(['sentAt']) || request.resource.data.sentAt is string)
        && (!changed.hasAny(['sentBy']) || request.resource.data.sentBy == request.auth.uid);
    }

    // Notification text is deliberately a small, generic envelope. Medical
    // and money details never need to be copied into an activity record just
    // to say that something changed.
    function safeActivity() {
      return request.resource.data.keys().hasAll([
          'category', 'actorUid', 'actorName', 'title', 'body', 'url', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'category', 'actorUid', 'actorName', 'title', 'body', 'url', 'createdAt',
          'sourceId', 'count'
        ])
        && request.resource.data.category in [
          'feed', 'photos', 'calendar', 'care', 'money', 'family'
        ]
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() <= 120
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 160
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 128
        && request.resource.data.createdAt is string
        && (!request.resource.data.keys().hasAny(['sourceId'])
            || request.resource.data.sourceId is string)
        && (!request.resource.data.keys().hasAny(['count'])
            || request.resource.data.count is int);
    }

    // --- members ------------------------------------------------------------
    match /members/{uid} {
      allow read: if isFamily();

      // You may only ever write your OWN member document, and only if you were
      // let in: either you are already family, or you are holding a valid
      // invitation whose code you name in the document you are creating.
      // Without one of those, a stranger who finds the app can sign in with
      // Google and write themselves onto the allowlist.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && validInvite(request.resource.data.inviteCode);

      allow update: if isFamily()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;

      // Removing someone is a deliberate act done in the console, not from the
      // app, so nobody can lock the rest of the family out by accident.
      allow delete: if false;
    }

    // --- invitations --------------------------------------------------------
    match /invitations/{code} {
      // The intended recipient may read their own invitation. A signed-in
      // stranger cannot use a leaked code to discover who it was sent to.
      allow get: if isFamily()
        || (signedIn()
            && resource.data.email is string
            && resource.data.email == request.auth.token.email);
      allow list: if isFamily();

      allow create: if isFamily() && safeNewInvite(code);
      allow delete: if isFamily();

      // Family members may cancel an invitation. The person joining may only
      // stamp it as used, and only if it is not used already - so a forwarded
      // copy cannot be burned by a bystander to lock out the genuine invitee.
      allow update: if (isFamily() && safeFamilyInviteUpdate())
        || (isFamily()
            && validInvite(code)
            && resource.data.usedBy == null
            && request.resource.data.usedBy == request.auth.uid
            && request.resource.data.usedAt is string
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['usedBy', 'usedAt']));
    }

    // --- module toggles -----------------------------------------------------
    match /modules/{document=**} {
      allow read, write: if isFamily();
    }

    // --- content ------------------------------------------------------------
    // Anyone in the family can post; only the author can delete their own.
    match /messages/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.authorId == request.auth.uid;
      allow update: if isFamily() && resource.data.authorId == request.auth.uid;
      allow delete: if isFamily() && resource.data.authorId == request.auth.uid;
    }

    match /calendar_events/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      // Plans change and anyone may be the one to update them, but only the
      // person who added an event can remove it.
      allow update: if isFamily();
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    // --- care and money records -------------------------------------------
    // These collections contain the family's most sensitive reference data.
    // They remain inside the same explicit member allowlist as the rest of the
    // dashboard. A creator is stamped on every record; any family member may
    // update shared information, but only its creator may remove it.
    match /financial_records/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /expenses/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /budgets/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /medical_info/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /medications/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /medication_logs/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /appointments/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /care_logs/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /wellness_checks/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    // Pointer records for files in Drive. The files themselves are protected by
    // Drive's own sharing, not by these rules.
    match /files/{id} {
      allow read, write: if isFamily();
    }

    // Who is in each photo, plus the date and event, imported from an offline
    // face-recognition run. Stored as a handful of chunk documents rather than
    // one per photo - see src/catalog-store.js for why.
    //
    // This is the most personal data in the database: it is a list of family
    // members' names attached to photographs. It stays behind the same family
    // allowlist as everything else, and never leaves Firestore.
    match /photo_catalog/{id} {
      allow read, write: if isFamily();
    }

    // Corrections made by hand: a person added, a wrong one removed, a date
    // fixed or cleared. Anyone in the family may correct any photo - the person
    // who recognises a face is not always the one who uploaded it, and that is
    // rather the point of a shared family album.
    match /photo_edits/{driveId} {
      allow read, write: if isFamily();
    }

    // Per-person notification preferences. Yours alone - nobody else in the
    // family needs to see or change what you have opted into.
    match /notification_prefs/{uid} {
      allow read: if isFamily() && request.auth.uid == uid;
      allow create, update: if isFamily()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['uid', 'enabled', 'categories', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'enabled', 'categories', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt is string
        && request.resource.data.categories is map
        && request.resource.data.categories.keys().hasAll([
          'feed', 'photos', 'calendar', 'care', 'money', 'family'
        ])
        && request.resource.data.categories.keys().hasOnly([
          'feed', 'photos', 'calendar', 'care', 'money', 'family'
        ])
        && request.resource.data.categories.feed is bool
        && request.resource.data.categories.photos is bool
        && request.resource.data.categories.calendar is bool
        && request.resource.data.categories.care is bool
        && request.resource.data.categories.money is bool
        && request.resource.data.categories.family is bool;
      allow delete: if isFamily() && request.auth.uid == uid;
    }

    // Generic activity envelopes are family-readable so an open PWA can
    // deliver them. Only the actor may create one, and nobody edits history.
    match /activity_events/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && safeActivity();
      allow update, delete: if false;
    }

    // Push endpoints are credentials for reaching a particular device. Other
    // family members do not need to see them; a future trusted sender bypasses
    // client rules through the Admin SDK.
    match /devices/{id} {
      allow read: if isFamily() && resource.data.uid == request.auth.uid;
      allow create: if isFamily() && request.resource.data.uid == request.auth.uid;
      allow update: if isFamily()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isFamily() && resource.data.uid == request.auth.uid;
    }

    // Audited records for the additional modular features: discussions,
    // coordination, documents, history, household tools, polls and fun lists.
    // Every item includes a moduleKey; the UI only queries the active module.
    match /lists/{id} {
      allow read, write: if isFamily();
    }
    match /list_items/{id} {
      allow read, write: if isFamily();
    }

    // Anything not named above is denied. New modules must add their own block
    // rather than inheriting blanket access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

// Firestore security rules for the family dashboard.
//
// Paste these into Firebase console → Firestore Database → Rules → Publish.
//
// The model is deliberately simple because this is ONE family's private app,
// not a multi-tenant product: if you have a document in /members, you are in
// the family and you can read and write the family's data. There is no
// per-record ownership beyond "you can only delete your own posts".
//
// BOOTSTRAPPING: the first member has to be added by hand, otherwise nobody
// could ever get in - the rules require a member document to create a member
// document. In the Firebase console, create:
//
//     /members/<your-firebase-auth-uid>   { email: "you@example.com" }
//
// After that, everyone else is added automatically when they first sign in.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The allowlist. Membership is the only permission this app has.
    function isFamily() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    // An invitation that is real, still live, and meant for whoever is holding
    // it. This is the ONLY route into the family that does not already require
    // being in it, so every condition here is load-bearing:
    //
    //   revoked / usedBy   - cancelled and spent invitations are dead
    //   expiresAt          - epoch millis, so it can be compared to request.time
    //   email              - when set, only that Google account may use it, so a
    //                        forwarded link is worthless to anybody else
    function validInvite(code) {
      return code is string
        && exists(/databases/$(database)/documents/invitations/$(code))
        && inviteData(code).revoked != true
        && inviteData(code).usedBy == null
        && inviteData(code).expiresAt is number
        && request.time.toMillis() < inviteData(code).expiresAt
        && (inviteData(code).email == null
            || inviteData(code).email == request.auth.token.email);
    }

    function inviteData(code) {
      return get(/databases/$(database)/documents/invitations/$(code)).data;
    }

    // --- members ------------------------------------------------------------
    match /members/{uid} {
      allow read: if isFamily();

      // You may only ever write your OWN member document, and only if you were
      // let in: either you are already family, or you are holding a valid
      // invitation whose code you name in the document you are creating.
      // Without one of those, a stranger who finds the app can sign in with
      // Google and write themselves onto the allowlist.
      allow create: if signedIn() && request.auth.uid == uid
        && (isFamily() || validInvite(request.resource.data.inviteCode));

      allow update: if isFamily() && request.auth.uid == uid;

      // Removing someone is a deliberate act done in the console, not from the
      // app, so nobody can lock the rest of the family out by accident.
      allow delete: if false;
    }

    // --- invitations --------------------------------------------------------
    match /invitations/{code} {
      // A single invitation can be read by anyone signed in, because knowing
      // the code already implies having been sent it. Listing them is family
      // only - otherwise any Google account could enumerate every outstanding
      // invitation and the email addresses attached to them.
      allow get: if isFamily() || signedIn();
      allow list: if isFamily();

      allow create, delete: if isFamily();

      // Family members may cancel an invitation. The person joining may only
      // stamp it as used, and only if it is not used already - so a forwarded
      // copy cannot be burned by a bystander to lock out the genuine invitee.
      allow update: if isFamily()
        || (signedIn()
            && resource.data.usedBy == null
            && request.resource.data.usedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['usedBy', 'usedAt']));
    }

    // --- module toggles -----------------------------------------------------
    match /modules/{document=**} {
      allow read, write: if isFamily();
    }

    // --- content ------------------------------------------------------------
    // Anyone in the family can post; only the author can delete their own.
    match /messages/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.authorId == request.auth.uid;
      allow update: if isFamily() && resource.data.authorId == request.auth.uid;
      allow delete: if isFamily() && resource.data.authorId == request.auth.uid;
    }

    match /calendar_events/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      // Plans change and anyone may be the one to update them, but only the
      // person who added an event can remove it.
      allow update: if isFamily();
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    // --- care and money records -------------------------------------------
    // These collections contain the family's most sensitive reference data.
    // They remain inside the same explicit member allowlist as the rest of the
    // dashboard. A creator is stamped on every record; any family member may
    // update shared information, but only its creator may remove it.
    match /financial_records/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /expenses/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /budgets/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /medical_info/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /medications/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /medication_logs/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /appointments/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /care_logs/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    match /wellness_checks/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamily()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFamily() && resource.data.createdBy == request.auth.uid;
    }

    // Pointer records for files in Drive. The files themselves are protected by
    // Drive's own sharing, not by these rules.
    match /files/{id} {
      allow read, write: if isFamily();
    }

    // Who is in each photo, plus the date and event, imported from an offline
    // face-recognition run. Stored as a handful of chunk documents rather than
    // one per photo - see src/catalog-store.js for why.
    //
    // This is the most personal data in the database: it is a list of family
    // members' names attached to photographs. It stays behind the same family
    // allowlist as everything else, and never leaves Firestore.
    match /photo_catalog/{id} {
      allow read, write: if isFamily();
    }

    // Corrections made by hand: a person added, a wrong one removed, a date
    // fixed or cleared. Anyone in the family may correct any photo - the person
    // who recognises a face is not always the one who uploaded it, and that is
    // rather the point of a shared family album.
    match /photo_edits/{driveId} {
      allow read, write: if isFamily();
    }

    // Per-person notification preferences. Yours alone - nobody else in the
    // family needs to see or change what you have opted into.
    match /notification_prefs/{uid} {
      allow read, write: if isFamily() && request.auth.uid == uid;
    }

    // Registered devices for push. Written by the owning member only.
    match /devices/{id} {
      allow read: if isFamily();
      allow write: if isFamily() && request.resource.data.uid == request.auth.uid;
    }

    // Audited records for the additional modular features: discussions,
    // coordination, documents, history, household tools, polls and fun lists.
    // Every item includes a moduleKey; the UI only queries the active module.
    match /lists/{id} {
      allow read, write: if isFamily();
    }
    match /list_items/{id} {
      allow read, write: if isFamily();
    }

    // Anything not named above is denied. New modules must add their own block
    // rather than inheriting blanket access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
